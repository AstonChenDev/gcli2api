# ============================================================================
# GCLI2API production environment template
# Copy to .env on each server, fill all required values, then chmod 600 .env.
# Never commit the real .env file.
# ============================================================================

# ----- Compose topology -----
COMPOSE_PROJECT_NAME=gcli2api
ENV_FILE=.env

# production-1 (7861 + 7862 + 7863): candidate,v3
# production-2 (7861 + 7862):        candidate
COMPOSE_PROFILES=candidate

IMAGE_REPOSITORY=gcli2api

# Use immutable Git commit IDs. During blue/green rollout the primary and
# candidate tags can intentionally point at different releases.
PRIMARY_IMAGE_TAG=current
CANDIDATE_IMAGE_TAG=candidate
V3_IMAGE_TAG=current

PRIMARY_CONTAINER_NAME=my-gcli2api
CANDIDATE_CONTAINER_NAME=my-gcli2api-new
V3_CONTAINER_NAME=my-gcli2api-v3

BIND_ADDRESS=0.0.0.0
PRIMARY_PORT=7861
CANDIDATE_PORT=7862
V3_PORT=7863
GEMINICLI_CALLBACK_HOST_PORT=11452
ANTIGRAVITY_CALLBACK_HOST_PORT=11454
WORKERS=4
CREDS_DIR=./data/creds

# Docker JSON log rotation.
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5

# ----- Required secrets -----
# Required by docker-compose.yml. Use a new strong value; do not keep the
# project's historical default password.
PASSWORD=

# Optional split passwords. Leave empty to inherit PASSWORD.
API_PASSWORD=
PANEL_PASSWORD=

# ----- Storage -----
# Production uses PostgreSQL. Both existing production hosts run PostgreSQL on
# their own host port 15432; host.docker.internal is provided by Compose.
# URL-encode special characters in the username/password.
POSTGRESQL_URI=

# Leave these empty while PostgreSQL is enabled.
MONGODB_URI=
MONGODB_DATABASE=gcli2api
REDIS_URL=

# Local-file fallback path inside the container.
CREDENTIALS_DIR=/app/creds

# ----- Tencent COS (optional) -----
# Set all required COS values together, or leave all of them empty.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_URL_PREFIX=
COS_PATH_PREFIX=generated/

# ----- Network proxies (optional) -----
PROXY=
KEEPALIVE_URL=
KEEPALIVE_INTERVAL=60

# Leave endpoint variables empty to use built-in official endpoints.
CODE_ASSIST_ENDPOINT=
OAUTH_PROXY_URL=
GOOGLEAPIS_PROXY_URL=
RESOURCE_MANAGER_API_URL=
SERVICE_USAGE_API_URL=
ANTIGRAVITY_API_URL=

# ----- Application behavior -----
AUTO_BAN=false
AUTO_BAN_ERROR_CODES=403
RETRY_429_ENABLED=true
RETRY_429_MAX_RETRIES=5
RETRY_429_INTERVAL=1
# Positive minutes enable Antigravity 429 cooldown; use "none" to disable it.
ANTIGRAVITY_RESOURCE_EXHAUSTED_COOLDOWN_MINUTES=10

# Retry only exact Antigravity capacity errors through a separately managed
# egress proxy. Keep disabled until the private SOCKS/HTTP route is healthy.
ANTIGRAVITY_CAPACITY_FALLBACK_ENABLED=false
ANTIGRAVITY_CAPACITY_FALLBACK_PROXY_URL=
ANTIGRAVITY_CAPACITY_FALLBACK_HTTP_STATUSES=503
ANTIGRAVITY_CAPACITY_FALLBACK_ERROR_STATUSES=UNAVAILABLE
ANTIGRAVITY_CAPACITY_FALLBACK_REASONS=MODEL_CAPACITY_EXHAUSTED
ANTIGRAVITY_CAPACITY_FALLBACK_MODELS=*
ANTIGRAVITY_CAPACITY_FALLBACK_MAX_ATTEMPTS=1
ANTIGRAVITY_CAPACITY_FALLBACK_CONNECT_TIMEOUT_SECONDS=5
ANTIGRAVITY_CAPACITY_FALLBACK_REQUEST_TIMEOUT_SECONDS=900
ANTIGRAVITY_CAPACITY_FALLBACK_STATS_ENABLED=true
ANTIGRAVITY_CAPACITY_FALLBACK_ROUTE_NAME=capacity-egress

# Caller IP statistics use the direct connection IP by default. If requests
# arrive through a reverse proxy, trust only that proxy's IP/CIDR when possible.
TRUSTED_PROXY_IPS=
# Set true only when the service cannot be reached except through a trusted proxy.
TRUST_PROXY_HEADERS=false
ANTI_TRUNCATION_MAX_ATTEMPTS=3
COMPATIBILITY_MODE=false
RETURN_THOUGHTS_TO_FRONTEND=true
ANTIGRAVITY_STREAM2NOSTREAM=true
ANTIGRAVITY_SWITCH_CREDENTIAL=false
CREDENTIAL_SELECTION_STRATEGY=random
VERTEX_MAX_RETRIES=3

# ----- Logging -----
ENABLE_LOG=1
LOG_LEVEL=info
LOG_FILE=log.txt

# Avoid verbose Anthropic payload logging in production.
ANTHROPIC_DEBUG=false
