# Bind only to the Docker bridge gateway, never a public interface.
CAPACITY_EGRESS_LISTEN_HOST=172.17.0.1
CAPACITY_EGRESS_LISTEN_PORT=19080

# Changing these values moves the fallback egress to another SSH server.
CAPACITY_EGRESS_SSH_HOST=jump-host.example
CAPACITY_EGRESS_SSH_PORT=22
CAPACITY_EGRESS_SSH_USER=gcli-egress

# Files stay outside the repository and must be readable only by gcli-egress.
CAPACITY_EGRESS_IDENTITY_FILE=/etc/gcli2api/capacity-egress/id_ed25519
CAPACITY_EGRESS_KNOWN_HOSTS_FILE=/etc/gcli2api/capacity-egress/known_hosts
